NONCE_KEY=generate-with-wordpress-secret-key-service
AUTH_SALT=generate-with-wordpress-secret-key-service
SECURE_AUTH_SALT=generate-with-wordpress-secret-key-service
LOGGED_IN_SALT=generate-with-wordpress-secret-key-service
NONCE_SALT=generate-with-wordpress-secret-key-service
WP_CACHE_KEY_SALT=generate-with-wordpress-secret-key-service
